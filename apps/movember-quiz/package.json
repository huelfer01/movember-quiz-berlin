{
    "name": "movember-office-quiz",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.12.0 <25"
    },
    "scripts": {
        "build": "node scripts/build.ts",
        "start": "node server/src/main.ts",
        "dev": "node scripts/package.mjs && node --watch server/src/main.ts",
        "test": "node scripts/package.mjs && node --test tests/*.test.mjs",
        "test:unit": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
        "test:integration": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
        "build:cloudflare": "node scripts/build-cloudflare.ts"
    }
}
