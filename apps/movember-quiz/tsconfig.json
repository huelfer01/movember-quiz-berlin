{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["node", "jest"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "skipLibCheck": true,
        "isolatedModules": true
    },
    "include": [
        "server/src/**/*.ts",
        "test/**/*.ts",
        "scripts/build.ts",
        "scripts/build-cloudflare.ts",
        "quiz/_worker.d.ts"
    ]
}
